# Ground-truth extraction artifacts are small (~80KB/file) and critical for
# reproducibility -- tracked despite the broad .rds exclusion above
!data/simulated/ground_truth/**/*.rds

# Small (~tens of MB), permanent evidence sample of the Step 1.7 bug --
# tracked despite the broad .rds exclusion above
!data/simulated/step1_7_bug_evidence_sample/**
data/processed/**/*.rds
!logs/step3_1_progress.csv
!logs/step3_2_progress.csv
!logs/step3_3_progress.csv
!logs/step3_4_progress.csv
!logs/step3_5_progress.csv
!logs/step3_5_rescue_progress.csv
!logs/step3_5_rescue2_progress.csv
venv_glmpca_gpu/
!logs/step3_6_progress.csv
!logs/loadings_backfill_progress.csv
!logs/raw_recovery_progress.csv
!logs/step3_5_v2_progress.csv

# Raw verbose stdout redirects (e.g. `Rscript foo.R > run.log 2>&1`) run
# from the project root rather than into logs/ -- their useful content is
# already distilled into the tracked logs/step*_progress.csv summaries.
# Historical instances removed in the same commit that added this rule.
*.log
Rplots.pdf
